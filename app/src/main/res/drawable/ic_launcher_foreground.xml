<!--
  Firefly mark: a battery outline holding one glowing node at the charge line.
  Deliberately a single node with a halo rather than a node plus a spark shape — at
  launcher sizes two overlapping bright forms merge into a smudge.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Glow halo -->
    <path android:pathData="M54,50m-17,0a17,17 0,1 1,34 0a17,17 0,1 1,-34 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="50"
                android:gradientRadius="17"
                android:startColor="#66C6F24E"
                android:endColor="#00C6F24E" />
        </aapt:attr>
    </path>

    <!-- Battery body -->
    <path
        android:pathData="M42,32 L62,32 A5,5 0 0 1 67,37 L67,71 A5,5 0 0 1 62,76 L42,76 A5,5 0 0 1 37,71 L37,37 A5,5 0 0 1 42,32 Z"
        android:strokeColor="#F8FAFC"
        android:strokeWidth="4.5"
        android:fillColor="#00000000" />

    <!-- Terminal cap -->
    <path
        android:pathData="M47,26 L57,26 A2,2 0 0 1 59,28 L59,32 L45,32 L45,28 A2,2 0 0 1 47,26 Z"
        android:fillColor="#F8FAFC" />

    <!-- Charge fill, kept clear of the node so the two never merge -->
    <path
        android:pathData="M41,60 L63,60 L63,69 A3,3 0 0 1 60,72 L44,72 A3,3 0 0 1 41,69 Z"
        android:fillColor="#C6F24E"
        android:fillAlpha="0.45" />

    <!-- The firefly: one bright node above the charge line -->
    <path
        android:pathData="M54,50m-6,0a6,6 0,1 1,12 0a6,6 0,1 1,-12 0"
        android:fillColor="#C6F24E" />
    <path
        android:pathData="M54,50m-2.8,0a2.8,2.8 0,1 1,5.6 0a2.8,2.8 0,1 1,-5.6 0"
        android:fillColor="#F4FFD6" />
</vector>
