<!--
  Firefly mark: a battery outline containing a single glowing node sitting at the fill
  line. Drawn on the 108dp adaptive canvas with all artwork inside the central 66dp
  safe zone, so no launcher mask can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Glow halo behind the node -->
    <path
        android:pathData="M54,54m-19,0a19,19 0,1 1,38 0a19,19 0,1 1,-38 0"
        android:fillAlpha="0.16">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="19"
                android:startColor="#C6F24E"
                android:endColor="#00C6F24E" />
        </aapt:attr>
    </path>

    <!-- Battery body -->
    <path
        android:pathData="M42,32 L62,32 A5,5 0 0 1 67,37 L67,71 A5,5 0 0 1 62,76 L42,76 A5,5 0 0 1 37,71 L37,37 A5,5 0 0 1 42,32 Z"
        android:strokeColor="#F8FAFC"
        android:strokeWidth="4"
        android:fillColor="#00000000" />

    <!-- Terminal cap -->
    <path
        android:pathData="M47,27 L57,27 A2,2 0 0 1 59,29 L59,32 L45,32 L45,29 A2,2 0 0 1 47,27 Z"
        android:fillColor="#F8FAFC" />

    <!-- Charge fill, sitting below the node -->
    <path
        android:pathData="M41,62 L63,62 L63,70 A3,3 0 0 1 60,73 L44,73 A3,3 0 0 1 41,70 Z"
        android:fillColor="#C6F24E"
        android:fillAlpha="0.35" />

    <!-- The firefly itself: the glowing node at the fill line -->
    <path
        android:pathData="M52,54.5 L56,48 L54.5,53.5 L58.5,53 L53,61 L54.5,55.5 Z"
        android:fillColor="#C6F24E" />
    <path
        android:pathData="M54,54m-3.2,0a3.2,3.2 0,1 1,6.4 0a3.2,3.2 0,1 1,-6.4 0"
        android:fillColor="#E8FFA8" />
</vector>
