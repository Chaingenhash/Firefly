<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose paints the whole screen, so this theme exists mainly to give the window a
      background that matches the palette before the first frame, and to follow the
      system light/dark setting rather than pinning the app to light.
    -->
    <style name="Theme.Firefly" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
